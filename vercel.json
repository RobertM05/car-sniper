{
    "regions": ["fra1"],
    "builds": [
        {
            "src": "backend/main.py",
            "use": "@vercel/python"
        },
        {
            "src": "frontend/car-sniper/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/backend/main.py"
        },
        {
            "src": "/(assets/.*|.*\\.(ico|png|jpg|jpeg|svg|css|js|json|woff|woff2|ttf|eot))$",
            "dest": "/frontend/car-sniper/$1"
        },
        { "handle": "filesystem" },
        {
            "src": "/(.*)",
            "dest": "/frontend/car-sniper/index.html"
        }
    ]
}