#!/bin/bash
# Block AI-generated markers and trailing whitespace in commits
FAILED=0
PATTERNS=(
  "🤖 Generated with"
  "Co-Authored-By: Claude"
  "Co-Authored-By: Anthropic"
  "noreply@anthropic.com"
)
for pattern in "${PATTERNS[@]}"; do
  HITS=$(git diff --cached -G"$pattern" --name-only 2>/dev/null)
  if [ -n "$HITS" ]; then
    echo "❌ Found AI marker: \"$pattern\" in: $HITS"
    FAILED=1
  fi
done
WHITESPACE=$(git diff --cached --check -- '*.py' '*.yaml' '*.yml' '*.md' 2>&1)
if [ -n "$WHITESPACE" ]; then
  echo "❌ Trailing whitespace: $WHITESPACE"
  FAILED=1
fi
[ $FAILED -eq 1 ] && echo "👉 Remove AI markers and trailing whitespace" && exit 1
echo "✅ Clean"
